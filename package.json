{
  "name": "starter",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "pnpm --filter @starter/e2e test:e2e:ui",
    "test:e2e:headed": "pnpm --filter @starter/e2e exec playwright test --headed",
    "db:push": "pnpm --filter @starter/db push --force",
    "db:studio": "pnpm --filter @starter/db studio",
    "db:generate": "pnpm --filter @starter/db generate",
    "db:reset": "docker compose down -v --remove-orphans && docker compose up -d && node -e \"setTimeout(()=>{},3000)\" && pnpm db:push && pnpm db:seed",
    "db:seed": "pnpm --filter @starter/db seed",
    "db:seed:sst": "pnpm --filter @starter/db seed:sst"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}

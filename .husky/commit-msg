#!/usr/bin/env sh
# Validates that the commit message follows the Conventional Commits spec.
# Pattern: <type>[optional scope]: <description>
# Examples: feat(auth): add login   |   fix: correct typo   |   chore!: drop node 16

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Skip merge commits and fixup/squash commits (handled by git itself)
first_line=$(echo "$commit_msg" | head -1)
case "$first_line" in
  Merge\ *|Revert\ *|fixup\!*|squash\!*) exit 0 ;;
esac

# Conventional Commits pattern
pattern="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\(.+\))?(!)?: .{1,}"

if ! echo "$first_line" | grep -qE "$pattern"; then
  echo ""
  echo "  ✘  Invalid commit message format!"
  echo ""
  echo "  Your message : $first_line"
  echo ""
  echo "  Expected format: <type>[optional scope]: <description>"
  echo "  Allowed types  : build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
  echo ""
  echo "  Examples:"
  echo "    feat(auth): add OAuth login"
  echo "    fix: correct calculation error"
  echo "    chore!: drop Node 16 support  (breaking change)"
  echo ""
  exit 1
fi
